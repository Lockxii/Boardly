# Local development
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Neon direct (unpooled) URL — used by Prisma `directUrl` for migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"  # >= 16 chars; boot fails in prod if unset
BETTER_AUTH_URL="http://localhost:5173"
# Extra trusted origin for auth/CORS, if the client is served from another host.
# CLIENT_ORIGIN="http://localhost:5173"
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
# TWITTER_REDIRECT_URI="http://localhost:5173/api/integrations/twitter/callback"
# TWITTER_BOOKMARK_IMPORT_LIMIT="1000"

# Vercel production (Project → Settings → Environment Variables)
# DATABASE_URL= Neon POOLED URL + ?pgbouncer=true&connection_limit=1 (Production + Preview + Development)
# DATABASE_URL_UNPOOLED= Neon direct URL (no pgbouncer) for migrations
# BETTER_AUTH_SECRET= openssl rand -base64 32
# BETTER_AUTH_URL=https://boardly-r3xr.vercel.app
# BLOB_READ_WRITE_TOKEN= auto-created by Vercel Blob (private boardly-uploads store)
#
# Schema updates: run locally with DATABASE_URL set → npx prisma migrate deploy

# Fred AI (Gemini) — server-side only, never expose to the client
GOOGLE_AI_API_KEY=""
# Liveblocks realtime collaboration — server-side only, never expose to the client
LIVEBLOCKS_SECRET_KEY="sk_live_..."
# Legacy Socket.io/Railway realtime envs are no longer required for cursor/canvas collaboration.
# Optional: gemini-2.5-flash (default), gemini-2.5-flash-lite, gemini-2.5-pro, etc.
# FRED_AI_MODEL="gemini-2.5-flash"
#
# Local: add to .env then restart `npm run dev` (Express does not hot-reload env).
# Vercel: Project → Settings → Environment Variables → GOOGLE_AI_API_KEY (Production + Preview).
