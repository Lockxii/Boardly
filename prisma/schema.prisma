
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions  Session[]
  accounts  Account[]
  boards    Board[]
  presences Presence[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  idToken String?

  @@map("account")
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
  @@index([identifier])
}

model Board {
  id        String   @id @default(cuid())
  title     String
  authorId  String
  template  String   @default("blank")
  canvasData Json?
  thumbnail  String?  @db.Text
  folder     String?
  tags       String[] @default([])
  isPublic   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  objects     BoardObject[]
  connections Connection[]
  presences   Presence[]
  members     BoardMember[]

  @@map("board")
}

model BoardMember {
  id        String   @id @default(cuid())
  boardId   String
  email     String
  role      String   @default("editor")
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, email])
  @@map("board_member")
}

model BoardObject {
  id        String   @id @default(cuid())
  boardId   String
  type      String
  x         Float
  y         Float
  width     Float?
  height    Float?
  fill      String?
  text      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@map("board_object")
}

model Connection {
  id        String   @id @default(cuid())
  boardId   String
  fromId    String
  toId      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@map("connection")
}

model Presence {
  id       String   @id @default(cuid())
  boardId  String
  userId   String
  lastSeen DateTime @default(now())
  cursorX  Float?
  cursorY  Float?

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("presence")
}

model ChatAttachment {
  id        String   @id @default(cuid())
  name      String
  type      String
  size      Int
  data      String
  createdAt DateTime @default(now())

  @@map("chat_attachment")
}
